{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "filter",
      "camelcase": "Fil",
      "title": "Filter",
      "scope": "source.filter",
      "file-types": [
        "filter"
      ],
      "injection-regex": "^filter$",
      "class-name": "TreeSitterFilter"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Grammar DSL filter untuk kotak pencarian halaman admin (Tugas 4 PLP)",
    "authors": [
      {
        "name": "Rasyad",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-filter",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}